<?xml version="1.0" encoding="UTF-8"?><project name="Application graphique de saisie de main courante lors de sauvetages" company="Groupe_TP3" webLink="https://github.com/Cheick011/Main-courante.git" view-date="2025-11-03" view-index="1" gantt-divider-location="351" resource-divider-location="300" version="3.3.3316" locale="fr_FR">
    <description><![CDATA[Le projet vise à développer une application graphique PyQt qui permet de saisir la main courante et de la partager entre différents PC lors d’intervention d’équipes du Spéléo-Secours Français (SSF).]]></description>
